{#- Header of every page except home. Expects: heroTitle, optional heroLead (HTML), heroImage, crumbs [{label, href}], heroMeta -#}
<section class="page-hero">
  {%- if heroImage %}
  <div class="page-hero-media" aria-hidden="true">
    <img src="{{ root }}assets/{{ heroImage }}" alt="" />
  </div>
  {%- endif %}
  <div class="page-hero-body">
    <nav aria-label="breadcrumbs">
      <ol class="crumbs">
        <li><a href="index.html">{{ T.home }}</a></li>
        {%- for c in crumbs %}
        <li>{% if c.href %}<a href="{{ c.href }}">{{ c.label }}</a>{% else %}<span aria-current="page">{{ c.label }}</span>{% endif %}</li>
        {%- endfor %}
      </ol>
    </nav>
    <h1>{{ heroTitle | safe }}</h1>
    {%- if heroLead %}
    <p class="page-hero-lead">{{ heroLead | safe }}</p>
    {%- endif %}
    {%- if heroMeta %}
    <p class="page-hero-meta">{{ heroMeta | safe }}</p>
    {%- endif %}
  </div>
</section>
