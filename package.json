{
  "name": "artisan-clinic",
  "version": "3.0.0",
  "description": "Artisan Clinic website — Eleventy sources in src/, static HTML built to dist/ (deployed via FTP).",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && eleventy && npm run css",
    "css": "cross-env NODE_ENV=production postcss src/css/main.css -o dist/assets/css/artisan.css --no-map",
    "start": "concurrently -k -n html,css \"eleventy --serve\" \"postcss src/css/main.css -o dist/assets/css/artisan.css --watch\"",
    "check": "node scripts/check-site.js"
  },
  "keywords": [],
  "author": "Krzysztof Dąbrowski",
  "license": "UNLICENSED",
  "dependencies": {
    "autoprefixer": "^10.4.14"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "cheerio": "^1.2.0",
    "concurrently": "^8.0.1",
    "cross-env": "^7.0.3",
    "cssnano": "^6.0.0",
    "js-yaml": "^5.4.3",
    "postcss": "^8.4.21",
    "postcss-cli": "^10.1.0",
    "postcss-import": "^15.1.0",
    "prettier": "^2.8.8"
  },
  "private": true
}
